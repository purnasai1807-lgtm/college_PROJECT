# Copy to .env on the server (never commit it). Every value below must be replaced.
APP_NAME=ACE Canteen
ENVIRONMENT=production
LOG_LEVEL=INFO
HTTPS_TERMINATED=true
PUBLIC_BASE_URL=https://canteen.your-college.edu

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
METRICS_TOKEN=
ACCESS_TOKEN_MINUTES=720

POSTGRES_DB=ace_canteen
POSTGRES_USER=ace_canteen
# At least 24 characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
APP_PORT=8000

# Razorpay: start with TEST keys (rzp_test_...), switch to live keys only after the pilot.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# Email for password resets (Brevo, Gmail app password, Amazon SES, your college SMTP ...)
PASSWORD_RESET_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="ACE Canteen <canteen@your-college.edu>"
SMTP_USE_SSL=false

# --- Canteen hours and pickup slots (leave the times empty for "always open, no slots") ---
CANTEEN_OPEN_TIME=09:00
CANTEEN_CLOSE_TIME=17:00
CANTEEN_TIMEZONE=Asia/Kolkata
CANTEEN_OPEN_DAYS=0,1,2,3,4,5
PICKUP_SLOT_MINUTES=15
PICKUP_SLOT_CAPACITY=10
PICKUP_MIN_LEAD_MINUTES=10
EMAIL_ORDER_READY=true
# Shared login throttling across workers (set automatically by docker compose). Optional for local runs.
REDIS_URL=
